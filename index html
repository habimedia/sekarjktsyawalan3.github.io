/* =====================================
   DATA PENCETAK GOL DAN KARTU
   Disimpan terpisah dari data utama
===================================== */

const MATCH_EVENTS_KEY = 'sekarJkt3MatchEvents';

function readMatchEvents(){
  try{
    return JSON.parse(localStorage.getItem(MATCH_EVENTS_KEY)) || {};
  }catch(e){
    return {};
  }
}

let matchEvents = readMatchEvents();

function saveMatchEvents(){
  localStorage.setItem(
    MATCH_EVENTS_KEY,
    JSON.stringify(matchEvents)
  );
}

/* TAMPILAN DETAIL GOL DAN KARTU */

function renderMatchEvents(matchId){
  const match = data.matches.find(m => m.id === matchId);
  if(!match) return '';

  const events = matchEvents[matchId] || [];
  if(!events.length) return '';

  function eventLines(items){
    return items.map(ev => {
      let icon = ev.type === 'goal'
        ? '⚽'
        : ev.type === 'yellow'
        ? '🟨'
        : '🟥';

      return `
        <div class="event-line">
          <span class="event-icon">${icon}</span>
          <span>
            ${esc(ev.name)}
            <span class="event-number">
              ${ev.number ? '(' + esc(ev.number) + ')' : ''}
            </span>
          </span>
        </div>
      `;
    }).join('');
  }

  function teamColumn(teamId, side){
    const goals = events.filter(
      ev => ev.teamId === teamId && ev.type === 'goal'
    );

    const cards = events.filter(
      ev => ev.teamId === teamId &&
      (ev.type === 'yellow' || ev.type === 'red')
    );

    return `
      <div class="event-column ${side}">
        <div>${eventLines(goals)}</div>
        <div class="event-card-list">
          ${eventLines(cards)}
        </div>
      </div>
    `;
  }

  return `
    <div class="match-events">
      ${teamColumn(match.home,'home')}
      ${teamColumn(match.away,'away')}
    </div>
  `;
}

/* FORM ADMIN DETAIL PERTANDINGAN */

