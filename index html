/* PERBARUI PILIHAN PERTANDINGAN DAN TIM */

function refreshMatchEventAdmin(){
  const matchSelect = document.getElementById('eventMatchSelect');
  const sideSelect = document.getElementById('eventTeamSide');
  const list = document.getElementById('matchEventAdminList');

  if(!matchSelect || !sideSelect || !list) return;

  const previousMatch = matchSelect.value;
  const previousSide = sideSelect.value;

  matchSelect.innerHTML = data.matches.map(m => {
    const home = team(m.home)?.name || 'Tim';
    const away = team(m.away)?.name || 'Tim';

    return `
      <option value="${esc(m.id)}">
        ${esc(home)} vs ${esc(away)}
      </option>
    `;
  }).join('');

  if(!data.matches.length){
    matchSelect.innerHTML =
      '<option value="">Belum ada pertandingan</option>';

    sideSelect.innerHTML = '';
    list.innerHTML =
      '<div class="notice">Buat pertandingan terlebih dahulu.</div>';
    return;
  }

  if(data.matches.some(m => m.id === previousMatch)){
    matchSelect.value = previousMatch;
  }

  const selected = data.matches.find(
    m => m.id === matchSelect.value
  );

  if(!selected) return;

  const homeName = team(selected.home)?.name || 'Tim Kandang';
  const awayName = team(selected.away)?.name || 'Tim Tandang';

  sideSelect.innerHTML = `
    <option value="home">${esc(homeName)}</option>
    <option value="away">${esc(awayName)}</option>
  `;

  sideSelect.value = previousSide;

  renderMatchEventAdminList();
}

/* DAFTAR DATA DI DASHBOARD ADMIN */

function renderMatchEventAdminList(){
  const matchId = document.getElementById('eventMatchSelect')?.value;
  const host = document.getElementById('matchEventAdminList');

  if(!host) return;

  const events = matchEvents[matchId] || [];

  const icon = {
    goal:'⚽',
    yellow:'🟨',
    red:'🟥'
  };

  const label = {
    goal:'Gol',
    yellow:'Kartu Kuning',
    red:'Kartu Merah'
  };

  host.innerHTML = events.map(ev => `
    <div class="event-admin-item">
      <span>
        ${icon[ev.type]}
        ${esc(ev.name)}
        ${ev.number ? '(' + esc(ev.number) + ')' : ''}
        • ${label[ev.type]}
      </span>

      <button class="btn"
        onclick="deleteMatchEvent('${esc(matchId)}','${esc(ev.id)}')">
        Hapus
      </button>
    </div>
  `).join('') || `
    <div class="notice">
      Belum ada pencetak gol atau kartu untuk pertandingan ini.
    </div>
  `;
}

/* TAMBAHKAN GOL ATAU KARTU */

function addMatchEvent(){
  const matchId =
    document.getElementById('eventMatchSelect').value;

  const side =
    document.getElementById('eventTeamSide').value;

  const type =
    document.getElementById('eventType').value;

  const name =
    document.getElementById('eventPlayerName').value.trim();

  const number =
    document.getElementById('eventPlayerNumber').value.trim();

  const match = data.matches.find(m => m.id === matchId);

  if(!match){
    toast('Pilih pertandingan terlebih dahulu.');
    return;
  }

  if(!name){
    toast('Isi nama pemain terlebih dahulu.');
    return;
  }

  const teamId = side === 'home'
    ? match.home
    : match.away;

  if(!matchEvents[matchId]){
    matchEvents[matchId] = [];
  }

  matchEvents[matchId].push({
    id:'event' + Date.now() + Math.random().toString(16).slice(2),
    teamId,
    type,
    name,
    number
  });

  saveMatchEvents();

  document.getElementById('eventPlayerName').value = '';
  document.getElementById('eventPlayerNumber').value = '';

  renderMatchEventAdminList();
  renderFixtures();

  toast('Data gol/kartu berhasil ditambahkan.');
}

/* HAPUS DATA GOL ATAU KARTU */

function deleteMatchEvent(matchId,eventId){
  if(!confirm('Hapus data ini?')) return;

  if(!matchEvents[matchId]) return;

  matchEvents[matchId] = matchEvents[matchId].filter(
    ev => ev.id !== eventId
  );

  if(!matchEvents[matchId].length){
    delete matchEvents[matchId];
  }

  saveMatchEvents();
  renderMatchEventAdminList();
  renderFixtures();

  toast('Data berhasil dihapus.');
}
