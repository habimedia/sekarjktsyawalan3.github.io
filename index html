function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function team(id){return data.teams.find(t=>t.id===id)}
function crest(t,cls=''){return t&&t.logo?`<img class="${cls}" src="${esc(t.logo)}" alt="Logo ${esc(t.name)}" onerror="this.style.display='none'">`:`<span class="${cls||'crest'}">${esc((t?.name||'S').split(' ').slice(-1)[0].slice(0,3).toUpperCase())}</span>`}
function renderTeams(){document.getElementById('teamGrid').innerHTML=data.teams.map(t=>`<article class="team-card"><div class="crest">${t.logo?`<img src="${esc(t.logo)}" alt="${esc(t.name)}" onerror="this.style.display='none'">`:`${esc(t.name.split(' ').slice(-1)[0].slice(0,3))}`}</div><div><b>${esc(t.name)}</b><small>SYAWALAN FUN MATCH • GROUP ${esc(t.group)}</small></div><span class="group-tag">${esc(t.group)}</span></article>`).join('')}
function statsFor(t){let s={p:0,w:0,d:0,l:0,gf:0,ga:0,pts:0};data.matches.filter(m=>m.status==='done'&&Number.isInteger(Number(m.sh))&&Number.isInteger(Number(m.sa))&&(m.home===t.id||m.away===t.id)).forEach(m=>{let home=m.home===t.id, f=Number(home?m.sh:m.sa),a=Number(home?m.sa:m.sh);s.p++;s.gf+=f;s.ga+=a;if(f>a){s.w++;s.pts+=3}else if(f===a){s.d++;s.pts++}else s.l++});s.gd=s.gf-s.ga;return s}
function renderTables(){document.getElementById('tables').innerHTML=['A','B'].map(g=>{
    let rows=data.teams
      .filter(t=>t.group===g)
      .map(t=>({t,s:statsFor(t)}))
      .sort((a,b)=>
        b.s.pts-a.s.pts||
        b.s.gd-a.s.gd||
        b.s.gf-a.s.gf||
        a.t.name.localeCompare(b.t.name)
      );

    return `<div class="table-card">
      <div class="table-title">
        GROUP ${g}
        <span>KLASEMEN SEMENTARA</span>
      </div>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>TEAM</th>
              <th>MP</th>
              <th>W</th>
              <th>D</th>
              <th>L</th>
              <th>GD</th>
              <th>PTS</th>
            </tr>
          </thead>
          <tbody>
            ${rows.map((r,i)=>`
              <tr>
                <td>${i+1}</td>
                <td>
                  <div class="standing-team">
                    ${crest(r.t,'standing-crest')}
                    <span>${esc(r.t.name)}</span>
                  </div>
                </td>
                <td>${r.s.p}</td>
                <td>${r.s.w}</td>
                <td>${r.s.d}</td>
                <td>${r.s.l}</td>
                <td>${r.s.gd>0?'+':''}${r.s.gd}</td>
                <td class="points">${r.s.pts}</td>
              </tr>
            `).join('')||'<tr><td colspan="8">Belum ada tim</td></tr>'}
          </tbody>
        </table>
      </div>
    </div>`;
  }).join('');
}
function matchCard(m){
  let h=team(m.home),a=team(m.away),done=m.status==='done',status=m.status==='done'?'done':m.status==='live'?'live':'scheduled',label=done?'SELESAI':status==='live'?'LIVE':'TERJADWAL';
  return `<article class="match">
    <div class="match-top"><span>${esc(m.date||'Tanggal belum diatur')} • ${esc(m.time||'')}</span><span class="status ${status}">${label}</span></div>
    <div class="match-body">
      <div class="side">${crest(h,'mini-crest')}<b>${esc(h?.name||'Tim')}</b></div>
      <div class="score">${done?`${Number(m.sh)} <small>:</small> ${Number(m.sa)}`:status==='live'?`${m.sh??0} <small>:</small> ${m.sa??0}`:'VS'}</div>
      <div class="side away">${crest(a,'mini-crest')}<b>${esc(a?.name||'Tim')}</b></div>
    </div>
    <div class="match-foot">${esc(m.venue||'Lokasi menyusul')} • Grup ${esc(h?.group||'-')}</div>
    ${renderMatchEvents(m.id)}
  </article>`;
}
function renderFixtures(){let list=[...data.matches].sort((a,b)=>(a.date||'9999').localeCompare(b.date||'9999')||(a.time||'').localeCompare(b.time||''));document.getElementById('fixturesList').innerHTML=list.length?list.map(matchCard).join(''):'<div class="empty">Jadwal pertandingan akan ditampilkan di sini.</div>';document.getElementById('statMatches').textContent=String(data.matches.length).padStart(2,'0');document.getElementById('statCompleted').textContent=String(data.matches.filter(m=>m.status==='done'&&m.sh!==''&&m.sa!==''&&Number.isFinite(Number(m.sh))&&Number.isFinite(Number(m.sa))).length).padStart(2,'0')}
function fillSelects(){let opts=data.teams.map(t=>`<option value="${esc(t.id)}">${esc(t.name)} (Grup ${esc(t.group)})</option>`).join('');['teamSelect','matchHome','matchAway'].forEach(id=>document.getElementById(id).innerHTML=opts)}
function sponsorStep(){
  const track=document.getElementById('sponsorTrack'),
  card=track?.querySelector('.sponsor');
  if(!track||!card)return 0;
  const gap=parseFloat(getComputedStyle(track).gap)||0;
  return card.getBoundingClientRect().width+gap;
}

function updateSponsorDots(){
  const track=document.getElementById('sponsorTrack'),
  step=sponsorStep();
  if(step)sponsorIndex=Math.max(0,Math.round(track.scrollLeft/step));
  document.querySelectorAll('#sponsorDots .dot')
  .forEach((d,i)=>d.classList.toggle('active',i===sponsorIndex));
}

function renderSponsors(){
  let arr=data.sponsors;
  const track=document.getElementById('sponsorTrack');
  track.innerHTML=arr.length?arr.map(s=>`<div class="sponsor">${s.image?`<a href="${esc(s.url||'#')}" target="_blank" rel="noopener" style="display:block;width:100%;height:100%"><img src="${esc(s.image)}" alt="${esc(s.name)}"></a>`:`<div class="sponsor-placeholder"><b>${esc(s.name)}</b><span>OFFICIAL PARTNER</span></div>`}</div>`).join(''):'<div class="empty">Sponsor akan ditampilkan di sini.</div>';
  track.scrollLeft=0;
  sponsorIndex=0;
  document.getElementById('sponsorCount').textContent=arr.length?`${arr.length} PARTNER${arr.length>1?'S':''}`:'PARTNERS';
  document.getElementById('sponsorDots').innerHTML=arr.map((_,i)=>`<span class="dot ${i===0?'active':''}"></span>`).join('');
  renderAdminLists();
}

function slideSponsors(dir){
  const track=document.getElementById('sponsorTrack'),
  step=sponsorStep();
  if(!track||!step||data.sponsors.length<2)return;
  const max=Math.max(0,track.scrollWidth-track.clientWidth);
  if(dir>0&&track.scrollLeft>=max-4){
    track.scrollTo({left:0,behavior:'smooth'});
  }else if(dir<0&&track.scrollLeft<=4){
    track.scrollTo({left:max,behavior:'smooth'});
  }else{
    track.scrollBy({left:dir*step,behavior:'smooth'});
  }
  setTimeout(updateSponsorDots,350);
}function renderNews(){document.getElementById('newsGrid').innerHTML=data.news.map(n=>`<article class="news"><small>SEKAR JKT UPDATE</small><h3>${esc(n.title)}</h3><p>${esc(n.body)}</p></article>`).join('')||'<div class="empty">Belum ada pengumuman.</div>';renderAdminLists()}
function renderAdminLists(){
  let ml=document.getElementById('adminMatchList');
  if(ml)ml.innerHTML=data.matches.map(m=>`<div class="admin-item"><span>${esc(team(m.home)?.name||'?')} vs ${esc(team(m.away)?.name||'?')} • ${m.status==='done'?'Selesai':m.status==='live'?'Live':'Terjadwal'}</span><span><button class="btn" onclick="editMatch('${esc(m.id)}')">Edit</button> <button class="btn" onclick="deleteMatch('${esc(m.id)}')">Hapus</button></span></div>`).join('');
  let sl=document.getElementById('adminSponsorList');
  if(sl)sl.innerHTML=data.sponsors.map((s,i)=>`<div class="admin-item"><span>${i+1}. ${esc(s.name)}</span><span><button class="btn" onclick="moveSponsor('${esc(s.id)}',-1)" ${i===0?'disabled':''}>↑</button> <button class="btn" onclick="moveSponsor('${esc(s.id)}',1)" ${i===data.sponsors.length-1?'disabled':''}>↓</button> <button class="btn" onclick="deleteSponsor('${esc(s.id)}')">Hapus</button></span></div>`).join('');
  let nl=document.getElementById('adminNewsList');
  if(nl)nl.innerHTML=data.news.map(n=>`<div class="admin-item"><span>${esc(n.title)}</span><button class="btn" onclick="deleteNews('${esc(n.id)}')">Hapus</button></div>`).join('');
}
function renderEventLogo(){const mark=document.getElementById('eventLogoMark');if(!mark)return;mark.innerHTML=data.eventLogo?`<img src="${esc(data.eventLogo)}" alt="Logo Event">`:'S';}
function saveEventLogo(){const file=document.getElementById('eventLogoFile').files[0];const url=document.getElementById('eventLogoUrl').value.trim();if(file){if(!file.type.startsWith('image/')){toast('Pilih file gambar.');return}if(file.size>1500000){toast('Ukuran logo maksimal 1,5 MB.');return}const reader=new FileReader();reader.onload=()=>{data.eventLogo=reader.result;persist();document.getElementById('eventLogoUrl').value='';document.getElementById('eventLogoFile').value='';toast('Logo event berhasil diperbarui.')};reader.readAsDataURL(file);return}if(!url){toast('Masukkan URL logo atau pilih gambar dari HP.');return}data.eventLogo=url;persist();toast('Logo event berhasil diperbarui.')}
function removeEventLogo(){data.eventLogo='';persist();document.getElementById('eventLogoUrl').value='';document.getElementById('eventLogoFile').value='';toast('Logo kembali ke huruf S.')}
function render(){renderEventLogo();renderTeams();renderTables();renderFixtures();fillSelects();renderSponsors();renderNews();document.getElementById('statTeams').textContent=String(data.teams.length).padStart(2,'0');document.getElementById('heroTeams').textContent=String(data.teams.length).padStart(2,'0')}
function toast(msg){let el=document.getElementById('toast');el.textContent=msg;el.style.display='block';clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>el.style.display='none',2400)}
function openAdminLoginFromMenu(){const menu=document.getElementById('navlinks');if(menu)menu.classList.remove('show');openLogin();}
function openLogin(){document.getElementById('loginModal').classList.add('show');document.getElementById('adminCode').value='';setTimeout(()=>document.getElementById('adminCode').focus(),50)}
function closeLogin(){document.getElementById('loginModal').classList.remove('show')}
function loginAdmin(){if(document.getElementById('adminCode').value===ADMIN_PASSWORD){closeLogin();document.getElementById('admin').classList.add('open');document.getElementById('admin').scrollIntoView({behavior:'smooth'});loadTeamForm();document.getElementById('eventLogoUrl').value=data.eventLogo&&/^https?:/i.test(data.eventLogo)?data.eventLogo:'';renderAdminLists()}else{document.getElementById('adminCode').value='';document.getElementById('adminCode').focus()}}
function closeAdmin(){document.getElementById('admin').classList.remove('open')}
function logoutAdmin(){closeAdmin();toast('Sesi admin ditutup.')}
function loadTeamForm(){let t=team(document.getElementById('teamSelect').value);if(t){document.getElementById('teamName').value=t.name;document.getElementById('teamGroup').value=t.group;document.getElementById('teamLogo').value=t.logo||''}}
function saveTeam(){let t=team(document.getElementById('teamSelect').value);if(!t)return;t.name=document.getElementById('teamName').value.trim()||t.name;t.group=document.getElementById('teamGroup').value;t.logo=document.getElementById('teamLogo').value.trim();persist();loadTeamForm();toast('Data tim berhasil disimpan.')}
function resetMatchForm(){editingMatch=null;['matchDate','matchVenue','scoreHome','scoreAway'].forEach(id=>document.getElementById(id).value='');document.getElementById('matchTime').value='08:00';document.getElementById('matchStatus').value='scheduled';document.getElementById('saveMatchBtn').textContent='Simpan Pertandingan'}
function editMatch(id){let m=data.matches.find(x=>x.id===id);if(!m)return;editingMatch=id;document.getElementById('matchHome').value=m.home;document.getElementById('matchAway').value=m.away;document.getElementById('matchDate').value=m.date||'';document.getElementById('matchTime').value=m.time||'08:00';document.getElementById('matchVenue').value=m.venue||'';document.getElementById('matchStatus').value=m.status||'scheduled';document.getElementById('scoreHome').value=m.sh??'';document.getElementById('scoreAway').value=m.sa??'';document.getElementById('saveMatchBtn').textContent='Perbarui Pertandingan';document.getElementById('matchHome').scrollIntoView({behavior:'smooth',block:'center'})}
function saveMatch(){
  let home=document.getElementById('matchHome').value,away=document.getElementById('matchAway').value,status=document.getElementById('matchStatus').value,sh=document.getElementById('scoreHome').value,sa=document.getElementById('scoreAway').value;
  if(!home||!away||home===away){toast('Pilih dua tim yang berbeda.');return}
  if(team(home)?.group!==team(away)?.group){toast('Pertandingan harus berasal dari grup yang sama.');return}
  if(status==='done'&&(sh===''||sa===''||!Number.isInteger(Number(sh))||!Number.isInteger(Number(sa))||Number(sh)<0||Number(sa)<0)){toast('Isi skor akhir dengan angka bulat 0 atau lebih.');return}
  if(status!=='done'&&(sh===''||sa==='')){sh='';sa=''}
  let m={id:editingMatch||('m'+Date.now()),home,away,date:document.getElementById('matchDate').value,time:document.getElementById('matchTime').value,venue:document.getElementById('matchVenue').value.trim(),status,sh:sh===''?'':Number(sh),sa:sa===''?'':Number(sa)};
  let idx=data.matches.findIndex(x=>x.id===m.id);
  if(idx>=0)data.matches[idx]=m;else data.matches.push(m);
  resetMatchForm();
  persist();
  refreshMatchEventAdmin();
  toast('Pertandingan dan klasemen berhasil diperbarui.');
}
function deleteMatch(id){
  if(!confirm('Hapus pertandingan ini?'))return;
  data.matches=data.matches.filter(m=>m.id!==id);
  delete matchEvents[id];
  saveMatchEvents();
  persist();
  refreshMatchEventAdmin();
  toast('Pertandingan dihapus.');
}
function saveSponsor(){let name=document.getElementById('sponsorName').value.trim(),image=document.getElementById('sponsorImage').value.trim(),url=document.getElementById('sponsorUrl').value.trim();if(!name){toast('Isi nama sponsor terlebih dahulu.');return}data.sponsors.push({id:'s'+Date.now(),name,image,url});['sponsorName','sponsorImage','sponsorUrl'].forEach(id=>document.getElementById(id).value='');persist();toast('Sponsor ditambahkan.')}
function deleteSponsor(id){if(!confirm('Hapus sponsor ini?'))return;data.sponsors=data.sponsors.filter(s=>s.id!==id);persist();toast('Sponsor dihapus.')}
  function moveSponsor(id,dir){
  const i=data.sponsors.findIndex(s=>s.id===id);
  const j=i+dir;
  if(i<0||j<0||j>=data.sponsors.length)return;
  [data.sponsors[i],data.sponsors[j]]=
  [data.sponsors[j],data.sponsors[i]];
  persist();
  toast('Urutan sponsor diperbarui.');
  }
function saveNews(){let title=document.getElementById('newsTitle').value.trim(),body=document.getElementById('newsBody').value.trim();if(!title||!body){toast('Lengkapi judul dan isi pengumuman.');return}data.news.unshift({id:'n'+Date.now(),title,body});document.getElementById('newsTitle').value='';document.getElementById('newsBody').value='';persist();toast('Pengumuman diterbitkan.')}
function deleteNews(id){if(!confirm('Hapus pengumuman ini?'))return;data.news=data.news.filter(n=>n.id!==id);persist();toast('Pengumuman dihapus.')}
function exportData(){let blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='sekar-jkt-fun-match-3-backup.json';a.click();URL.revokeObjectURL(url)}
function importData(e){let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{let d=JSON.parse(r.result);if(!Array.isArray(d.teams)||!Array.isArray(d.matches))throw Error();data={...structuredClone(seed),...d};persist();toast('Backup berhasil diimpor.')}catch(err){toast('File backup tidak valid.')}e.target.value=''};r.readAsText(f)}
function resetData(){if(!confirm('Kembalikan data ke pengaturan awal?'))return;data=structuredClone(seed);persist();resetMatchForm();toast('Data awal dipulihkan.')}
document.querySelectorAll('.admin-link').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();openAdminLoginFromMenu()}));
document.getElementById('adminCode').addEventListener('keydown',e=>{if(e.key==='Enter')loginAdmin()});
document.getElementById('sponsorTrack').addEventListener('scroll',()=>{
  window.requestAnimationFrame(updateSponsorDots);
});
setInterval(()=>{
  if(data.sponsors.length>1)slideSponsors(1);
},8000);
